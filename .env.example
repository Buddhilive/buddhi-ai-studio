# Copy this file to .env and adjust values as needed.
# Used by: Next.js dev/build, backend/app/core/config.py (pydantic-settings), docker-compose.yml.

# --- Frontend (Next.js) ---
# Base URL of the FastAPI backend, used by Next.js API routes as a proxy target.
BACKEND_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
# Optional Hugging Face token for downloading gated/private models.
# Can also be set later at runtime from the in-app Settings page instead.
HF_TOKEN=

# JSON array of allowed CORS origins.
CORS_ORIGINS=["http://localhost:3000"]

LITERT_BACKEND=cpu
CHAT_MAX_TOKENS_DEFAULT=1024
CHAT_REQUEST_TIMEOUT_S=120

EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_BATCH_SIZE=32

# Persist real prompt/response text per trace (Analytics > Traces).
ENABLE_TRACE_LOGGING=true
TRACE_RETENTION_DAYS=30
ENABLE_PROMETHEUS_METRICS=false
