FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv sqlite3 libpq5 curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

# Pre-install global MCP & Vibe-Stack CLIs for zero-latency offline execution
RUN npm install -g \
    next-devtools-mcp \
    shadcn@latest \
    drizzle-kit \
    @better-auth/cli \
    @modelcontextprotocol/server-postgres \
    typescript

# Pre-stage canonical Next.js 16+ Golden Starter
WORKDIR /opt/vibe-starter
COPY vibe-starter/package.json /opt/vibe-starter/package.json
RUN npm install --no-audit --no-fund
COPY vibe-starter/ /opt/vibe-starter/

WORKDIR /workspace
CMD ["sleep", "infinity"]
